# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# In production set this to your deployed URL (e.g. https://mngarments.vercel.app)
# so email open-tracking pixels resolve correctly.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Email (Gmail SMTP) ----
SMTP_USER=              # your Gmail address, e.g. sales@mngarments.com
SMTP_PASS=              # a Gmail App Password (NOT your account password)
FROM_NAME=MN Garments

# ---- Admin auth (simple env password gate) ----
ADMIN_EMAIL=admin@mngarments.com
ADMIN_PASSWORD=admin123
# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
